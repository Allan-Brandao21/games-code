# Copie para .env e preencha. NUNCA commite a chave.
PAGAMERICAN_API_KEY=pag_sua_chave_aqui

# Fonte de dados: mock | mcp | rest
DATA_SOURCE=mock

# --- MCP (recomendado: usa o server que a PagAmerican liberou) ---
# Caminho absoluto do server MCP (o mesmo do `claude mcp add pagamerican-data`)
PAGAMERICAN_MCP_SERVER=/caminho/absoluto/para/mcp/dist/server.js
# Opcional: nome do tool que devolve o resumo do dashboard. Se vazio, o bridge
# tenta descobrir (tools com "dashboard", "summary", "metrics", "overview").
PAGAMERICAN_MCP_DASHBOARD_TOOL=
# Opcional: nomes dos argumentos de período aceitos pelo tool (padrão: from,to)
PAGAMERICAN_MCP_FROM_ARG=from
PAGAMERICAN_MCP_TO_ARG=to

# --- REST (alternativa, se a PagAmerican expuser HTTP direto) ---
PAGAMERICAN_API_URL=https://api.pagamerican.com
PAGAMERICAN_DASHBOARD_PATH=/v1/dashboard

# Servidor
PORT=3000
HOST=0.0.0.0
# Token simples para proteger o app na rede (Authorization: Bearer <token> ou ?token=)
APP_TOKEN=
